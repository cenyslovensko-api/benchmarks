{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cenyslovensko/cenyslovensko-benchmarks/main/schemas/benchmark-report.schema.json",
  "title": "BenchmarkReport",
  "description": "A bulk benchmark report submitted by a single client after completing a full benchmark suite run.",
  "type": "object",
  "required": ["client", "benchmarks"],
  "additionalProperties": false,
  "properties": {
    "client": {
      "type": "string",
      "minLength": 1,
      "description": "Client/app identifier, e.g. 'python', 'go', 'rust'.",
      "examples": ["python", "go", "rust"]
    },
    "repository": {
      "type": "string",
      "description": "Source repository in 'org/repo' format.",
      "examples": ["cenyslovensko/cenyslovensko-python-client"]
    },
    "commit": {
      "type": "string",
      "description": "Full or short SHA of the commit that produced these results.",
      "examples": ["a1b2c3d4e5f6"]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 timestamp for the overall run. Defaults to the time of ingestion when omitted.",
      "examples": ["2024-01-15T10:30:00Z"]
    },
    "benchmarks": {
      "type": "array",
      "minItems": 1,
      "description": "One entry per measured metric.",
      "items": {
        "$ref": "#/$defs/BenchmarkEntry"
      }
    }
  },
  "$defs": {
    "BenchmarkEntry": {
      "type": "object",
      "required": ["name", "value", "unit"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Metric identifier, unique within the client.",
          "examples": ["api_latency_p50", "api_latency_p99", "throughput", "memory_usage"]
        },
        "value": {
          "type": "number",
          "description": "Numeric measurement result."
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "description": "Unit of measurement shown on charts.",
          "examples": ["ms", "req/s", "MB", "%", "ops/s"]
        }
      }
    }
  }
}
